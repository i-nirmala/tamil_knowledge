# Existing LLM key
GROQ_API_KEY=gsk_your_groq_key_here

# Supabase cloud persistence + authentication
# Project URL from Supabase Dashboard -> Connect / Data API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe publishable key is used only by the backend auth calls.
# Legacy anon key can also be used while your project still exposes it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only secret key. NEVER put this in frontend JavaScript.
# Current Supabase projects use sb_secret_...; older projects may expose service_role.
SUPABASE_SECRET_KEY=sb_secret_your_server_secret_here
